{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Start",
  "version": "1.0.0",
  "identifier": "com.ccstart.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CC Start",
        "width": 880,
        "height": 600,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": [
      "../../cc",
      "../../cc.cmd",
      "../../cc.ps1",
      "../../ccs.cmd",
      "../../ccs.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "template": "./nsis/installer.nsi"
      }
    }
  }
}
